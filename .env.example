# ─────────────────────────────────────────────────────────────
# GanaPlay Diseño — Plantilla de variables de entorno
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local al repositorio.
# ─────────────────────────────────────────────────────────────

# ── Firebase (cliente) ──────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── IA (multi-proveedor: usa la primera con saldo) ──────────
# Usada por /api/chat, /api/analyze y /api/brief-feedback.
# Prioridad de selección: OPENAI_API_KEY > OPENROUTER_API_KEY > DEEPSEEK_API_KEY.
# Si todas faltan, la IA funciona en modo simulación (no bloquea el flujo).
#
# RECOMENDADO PARA GANAPLAY (Opción 1 — máxima permisividad con visión):
#   Usa OpenRouter con un modelo open-weight que NO restringe contenido de
#   operadores licenciados de apuestas. Deja OPENAI_API_KEY vacío para que
#   OpenRouter sea el proveedor activo.
#
#   1) Crea cuenta en https://openrouter.ai/  y carga saldo (~$5 alcanzan para mucho).
#   2) Genera una API key (empieza con "sk-or-v1-…").
#   3) Llena las dos variables de abajo y reinicia `npm run dev`.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct
# Alternativas válidas para OPENROUTER_MODEL (todas con visión):
#   google/gemini-2.5-flash                       # rápido, políticas moderadas
#   anthropic/claude-haiku-4-5                    # calidad alta
#   meta-llama/llama-3.2-90b-vision-instruct      # open, muy permisivo
#   qwen/qwen2.5-vl-72b-instruct                  # open, recomendado

# OpenAI directo — funciona para análisis creativo de operador licenciado.
# Modelo recomendado: gpt-4o (vision + razonamiento de calidad alta; rechaza
# menos contenido de apuestas legítimo que gpt-4o-mini).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# (Opcional) DeepSeek — solo texto (sin visión). Útil como motor de
# razonamiento textual cuando NO hay imagen adjunta; barato y permisivo.
DEEPSEEK_API_KEY=

# (Opcional avanzado) Proveedor dedicado SOLO para visión. Si se define,
# tiene prioridad cuando se adjunta una imagen y el resto del chat puede
# correr con DeepSeek u OpenAI.
VISION_API_KEY=
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=qwen/qwen2.5-vl-72b-instruct

# ── Meta Ads API (opcional — solo lectura/diagnóstico) ──────
# Si se llenan, /api/meta-specs verifica conexión con /me. NUNCA crea
# campañas ni publica anuncios; solo lectura para mostrar estado en UI.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v21.0

# ── API externa / IFS (capa de servicio preparada) ──────────
NEXT_PUBLIC_API_BASE_URL=
API_AUTH_TOKEN=

# ── Acceso (validación de contraseñas en el servidor) ───────
# OBLIGATORIAS: sin ellas, /api/auth y /api/requests/admin-delete fallan
# cerrado (500). NO hay defaults en el código (el repo es público).
AUTH_PASS_TRAFFICKER=
AUTH_PASS_GENERAL=

# Directorio corporativo (opcional): amplía/sobrescribe SIN desplegar código
# el mapeo correo → rol/nombre del login por correo. JSON en una sola línea.
# Roles válidos: admin | cm | designer | operator | administrative
# Ej: AUTH_USERS=[{"email":"quota@ganaplay.com","role":"operator","name":"Quota"}]
AUTH_USERS=

# ── Correo / Alertas (Resend) ───────────────────────────────
# Sin estas variables, las alertas por correo se omiten sin bloquear el flujo.
RESEND_API_KEY=
EMAIL_FROM=GanaPlay Diseño <noreply@ganaplay.com>
# Correos del equipo de diseño/responsable (separados por coma).
# Reciben alerta cuando se crea una solicitud de prioridad Alto o Urgente.
DESIGN_TEAM_EMAILS=
# Asunto del correo de entrega ({titulo} se reemplaza por el título real).
EMAIL_SUBJECT_DELIVERY=Tu solicitud de diseño ya fue entregada - {titulo}

# ── App / equipo ────────────────────────────────────────────
# URL pública de la app (usada en los correos).
NEXT_PUBLIC_APP_URL=https://solicitudesgp.vercel.app
# Correo del Trafficker, autocompletado al crear solicitudes.
NEXT_PUBLIC_DEFAULT_TRAFFICKER_EMAIL=angel.vaca@ganaplay.com

# ── API IFS (capa de servicio preparada, aún sin conectar) ──
IFS_BASE_URL=
IFS_API_KEY=
IFS_TIMEOUT_MS=10000
